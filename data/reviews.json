  "positives": [
   "Easy-to-use layout for viewing policy details",
   "Smooth premium payment with several payment options",
   "Policy tracking, claims status and reminders in one place"
  ],
  "negatives": [
   "Occasional lag and login problems",
   "Slow customer-support response",
   "Customers want more self-service options"
  ],
